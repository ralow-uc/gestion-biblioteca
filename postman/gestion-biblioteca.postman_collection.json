{
  "info": {
    "name": "Gestion Biblioteca - API de libros",
    "description": "Colección Postman del microservicio gestion-biblioteca. Importar con File > Import y ejecutar en orden: Estado, POST, GET todos, GET por ID, PUT, DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "libroId", "value": "1" }
  ],
  "item": [
    {
      "name": "00 - Estado del servicio",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/estado", "host": ["{{baseUrl}}"], "path": ["api", "estado"] },
        "description": "Debe responder HTTP 200 con un cuerpo JSON que incluye estado OK."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('estado OK', () => pm.expect(pm.response.json().estado).to.eql('OK'));",
              "pm.test('base de datos conectada', () => pm.expect(pm.response.json().baseDeDatos.conectada).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - POST agregar un libro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela\",\n  \"autor\": \"Julio Cortazar\",\n  \"anioPublicacion\": 1963,\n  \"genero\": \"Novela\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/libros", "host": ["{{baseUrl}}"], "path": ["api", "libros"] },
        "description": "Agrega un nuevo libro a la base de datos. Responde 201 Created y guarda el ID en la variable libroId."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const libro = pm.response.json();",
              "pm.collectionVariables.set('libroId', libro.id);",
              "pm.test('devuelve los 5 atributos', () => {",
              "  pm.expect(libro).to.have.all.keys('id','titulo','autor','anioPublicacion','genero');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET todos los libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/libros", "host": ["{{baseUrl}}"], "path": ["api", "libros"] },
        "description": "Lista todos los libros. Admite el parametro opcional ?titulo= para filtrar."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET un libro por su ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/libros/{{libroId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "libros", "{{libroId}}"]
        },
        "description": "Obtiene la informacion de un libro por su ID."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('el ID coincide', () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get('libroId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - PUT actualizar un libro",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela\",\n  \"autor\": \"Julio Cortazar\",\n  \"anioPublicacion\": 1963,\n  \"genero\": \"Novela experimental\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/libros/{{libroId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "libros", "{{libroId}}"]
        },
        "description": "Actualiza la informacion de un libro existente."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('el genero se actualizo', () => pm.expect(pm.response.json().genero).to.eql('Novela experimental'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - DELETE eliminar un libro por su ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/libros/{{libroId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "libros", "{{libroId}}"]
        },
        "description": "Elimina un libro de la base de datos por su ID. Responde 204 No Content."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "06 - GET libro eliminado (debe dar 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/libros/{{libroId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "libros", "{{libroId}}"]
        },
        "description": "Confirma que el libro ya no existe tras el DELETE."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 404', () => pm.response.to.have.status(404));"]
          }
        }
      ]
    },
    {
      "name": "07 - POST invalido (validacion de atributos)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"\",\n  \"autor\": \"X\",\n  \"anioPublicacion\": 1200,\n  \"genero\": \"\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/libros", "host": ["{{baseUrl}}"], "path": ["api", "libros"] },
        "description": "Comprueba que el microservicio rechaza datos incompletos con HTTP 400 y detalla los errores."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('detalla los errores', () => pm.expect(pm.response.json().errores).to.be.an('object'));"
            ]
          }
        }
      ]
    }
  ]
}
